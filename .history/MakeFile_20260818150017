NAME = sersizShell

SRC = main.c

CC = gcc

LOGO = "@figlet -f smslant "SERIZSHELL"


SUCCESS = "\033[1;32m \n\t\t\t 🐙 SERIZSHELL HAVE BEEN CREATED SUCCESSFULLY! 🐙  \n\n"

CFLAGS = -Wall -Wextra -Werror

OBJCT = ${SRC:.c=.o}

$(NAME): $(OBJCT)

%.o: %.c
	@$(CC) $(CFLAGS) -c $< -o $@

all : $(NAME)
$(NAME) : $(OBJCT)
	@$(CC)  $(CFALGS) -lreadline -L /Users/tak/.brew/opt/readline/lib -I /Users/tak/.brew/opt/readline/include $(SRC) -o $(NAME)
	@printf $(LOGO)
clean :
	@rm -f $(OBJCT)
fclean : clean
	@rm -f $(NAME)
re : fclean all

.PHONY: clean all fclean re